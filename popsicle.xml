<?xml version="1.0" encoding="UTF-8"?>
<!--
  SoftOS · Xiaomi 17 Pro Max (popsicle) · LineageOS 24 (lineage-24.0) local manifest
  Copy to .repo/local_manifests/popsicle.xml, then `repo sync`.
  Blobs (vendor/xiaomi/popsicle, vendor/xiaomi/sm8850-common) and the stock kernel files are NOT
  in git: they are extracted from the stock HyperOS OS4.0.5.0.XPBCNXM fastboot package
  (device/xiaomi/popsicle/extract-files.py, device/xiaomi/popsicle-kernel/extract-files.sh).
-->
<manifest>
  <remote name="softos" fetch="https://github.com/softos-rom" />
  <remote name="mindthegapps" fetch="https://github.com/MindTheGapps" />

  <project path="device/xiaomi/popsicle" name="android_device_xiaomi_popsicle"
           remote="softos" revision="lineage-24.0" />
  <project path="device/xiaomi/sm8850-common" name="android_device_xiaomi_sm8850-common"
           remote="softos" revision="lineage-24.0" />
  <project path="device/xiaomi/popsicle-kernel" name="android_device_xiaomi_popsicle-kernel"
           remote="softos" revision="lineage-24.0" />
  <project path="hardware/xiaomi" name="android_hardware_xiaomi"
           remote="softos" revision="lineage-24.0" />

  <!-- Google apps: MindTheGapps for Android 17 (path must be vendor/gapps) -->
  <project path="vendor/gapps" name="vendor_gapps" remote="mindthegapps"
           revision="822ff6a805533792ae43a9c3f2a159222da22a6f" upstream="cinnamonbun" />
</manifest>
