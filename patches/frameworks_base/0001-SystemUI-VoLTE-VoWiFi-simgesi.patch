+package com.android.systemui.statusbar.pipeline.ims.data.repository
+
+import android.content.Context
+import android.content.pm.PackageManager
+import android.database.ContentObserver
+import android.net.Uri
+import android.telephony.SubscriptionManager
+import android.telephony.ims.ImsManager
+import android.telephony.ims.ImsMmTelManager
+import android.telephony.ims.ImsReasonInfo
+import android.telephony.ims.ImsRegistrationAttributes
+import android.telephony.ims.ImsStateCallback
+import android.telephony.ims.RegistrationManager
+import android.telephony.ims.feature.MmTelFeature
+import android.telephony.ims.stub.ImsRegistrationImplBase
+import android.util.Log
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.dagger.qualifiers.Application
+import com.android.systemui.dagger.qualifiers.Background
+import java.util.concurrent.Executor
+import javax.inject.Inject
+import kotlinx.coroutines.channels.awaitClose
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.callbackFlow
+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.flowOf
+
+/** IMS voice icon shown next to the signal icon of one subscription. */
+enum class ImsVoiceIcon {
+    NONE,
+    /** VoLTE / VoNR: user setting on AND IMS registered over LTE/NR with voice capability. */
+    HD,
+    /** VoWiFi: IMS registered over IWLAN with voice capability. */
+    VOWIFI,
+}
+
+/**
+ * SoftOS: tracks the real IMS voice state of a subscription (derived from the crDroid /
+ * LibreMobileOS ImsRepository, without any tuner or settings switch).
+ *
+ * The icon is shown only when the telephony stack confirms it:
+ * - [ImsVoiceIcon.HD]: [ImsMmTelManager.isAdvancedCallingSettingEnabled] is true, IMS is registered
+ *   over LTE or NR and the MmTel VOICE capability is available.
+ * - [ImsVoiceIcon.VOWIFI]: IMS is registered over IWLAN and the MmTel VOICE capability is
+ *   available.
+ */
+@SysUISingleton
+class ImsVoiceRepository
+@Inject
+constructor(
+    @Application private val context: Context,
+    // Single background looper thread: IMS callbacks are handled in arrival order.
+    @Background private val bgExecutor: Executor,
+) {
+
+    /** Cold flow; every collector registers its own IMS callbacks for [subId]. */
+    fun imsVoiceIcon(subId: Int): Flow<ImsVoiceIcon> {
+        if (!SubscriptionManager.isValidSubscriptionId(subId)) {
+            return flowOf(ImsVoiceIcon.NONE)
+        }
+        val hasIms =
+            try {
+                context.packageManager.hasSystemFeature(PackageManager.FEATURE_TELEPHONY_IMS)
+            } catch (e: RuntimeException) {
+                false
+            }
+        val imsManager = context.getSystemService(ImsManager::class.java)
+        if (!hasIms || imsManager == null) {
+            return flowOf(ImsVoiceIcon.NONE)
+        }
+
+        return callbackFlow {
+                val executor = bgExecutor
+                val mmTel: ImsMmTelManager = imsManager.getImsMmTelManager(subId)
+                val lock = Any()
+                var state = ImsVoiceState()
+                var callbacksRegistered = false
+
+                fun update(transform: (ImsVoiceState) -> ImsVoiceState) {
+                    synchronized(lock) {
+                        state = transform(state)
+                        trySend(state.toIcon())
+                    }
+                }
+
+                fun readVolteSetting(): Boolean =
+                    try {
+                        mmTel.isAdvancedCallingSettingEnabled()
+                    } catch (e: RuntimeException) {
+                        // Inactive subscription, telephony restarting, no IMS ...
+                        false
+                    }
+
+                val registrationCallback =
+                    object : RegistrationManager.RegistrationCallback() {
+                        override fun onRegistered(attributes: ImsRegistrationAttributes) {
+                            val volte = readVolteSetting()
+                            update {
+                                it.copy(
+                                    registered = true,
+                                    registrationTech = attributes.registrationTechnology,
+                                    volteSettingEnabled = volte,
+                                )
+                            }
+                        }
+
+                        override fun onRegistering(attributes: ImsRegistrationAttributes) {
+                            update { it.copy(registered = false) }
+                        }
+
+                        override fun onUnregistered(info: ImsReasonInfo) {
+                            update {
+                                it.copy(
+                                    registered = false,
+                                    registrationTech =
+                                        ImsRegistrationImplBase.REGISTRATION_TECH_NONE,
+                                )
+                            }
+                        }
+                    }
+
+                val capabilityCallback =
+                    object : ImsMmTelManager.CapabilityCallback() {
+                        override fun onCapabilitiesStatusChanged(
+                            capabilities: MmTelFeature.MmTelCapabilities
+                        ) {
+                            val volte = readVolteSetting()
+                            val voice =
+                                capabilities.isCapable(
+                                    MmTelFeature.MmTelCapabilities.CAPABILITY_TYPE_VOICE
+                                )
+                            update { it.copy(voiceCapable = voice, volteSettingEnabled = volte) }
+                        }
+                    }
+
+                fun unregisterImsCallbacks() {
+                    synchronized(lock) {
+                        if (!callbacksRegistered) return
+                        callbacksRegistered = false
+                    }
+                    try {
+                        mmTel.unregisterImsRegistrationCallback(registrationCallback)
+                    } catch (e: RuntimeException) {}
+                    try {
+                        mmTel.unregisterMmTelCapabilityCallback(capabilityCallback)
+                    } catch (e: RuntimeException) {}
+                }
+
+                val stateCallback =
+                    object : ImsStateCallback() {
+                        override fun onAvailable() {
+                            synchronized(lock) {
+                                if (callbacksRegistered) return
+                                callbacksRegistered = true
+                            }
+                            try {
+                                mmTel.registerImsRegistrationCallback(
+                                    executor,
+                                    registrationCallback,
+                                )
+                                mmTel.registerMmTelCapabilityCallback(executor, capabilityCallback)
+                            } catch (e: Exception) {
+                                Log.w(TAG, "sub=$subId IMS callbacks could not be registered", e)
+                                unregisterImsCallbacks()
+                                update { ImsVoiceState() }
+                            }
+                        }
+
+                        override fun onUnavailable(reason: Int) {
+                            unregisterImsCallbacks()
+                            update { ImsVoiceState() }
+                        }
+
+                        override fun onError() {
+                            unregisterImsCallbacks()
+                            update { ImsVoiceState() }
+                        }
+                    }
+
+                // VoLTE switch in SIM settings: TelephonyProvider notifies this URI (+ "/subId").
+                val settingObserver =
+                    object : ContentObserver(null) {
+                        override fun onChange(selfChange: Boolean, uri: Uri?) {
+                            executor.execute {
+                                val volte = readVolteSetting()
+                                update { it.copy(volteSettingEnabled = volte) }
+                            }
+                        }
+                    }
+
+                trySend(ImsVoiceIcon.NONE)
+                try {
+                    context.contentResolver.registerContentObserver(
+                        Uri.withAppendedPath(
+                            SubscriptionManager.ADVANCED_CALLING_ENABLED_CONTENT_URI,
+                            subId.toString(),
+                        ),
+                        false,
+                        settingObserver,
+                    )
+                } catch (e: RuntimeException) {
+                    Log.w(TAG, "sub=$subId setting observer could not be registered", e)
+                }
+                try {
+                    mmTel.registerImsStateCallback(executor, stateCallback)
+                } catch (e: Exception) {
+                    // No IMS for this subscription: the icon stays hidden.
+                    Log.w(TAG, "sub=$subId IMS state callback could not be registered", e)
+                }
+
+                awaitClose {
+                    try {
+                        context.contentResolver.unregisterContentObserver(settingObserver)
+                    } catch (e: RuntimeException) {}
+                    try {
+                        mmTel.unregisterImsStateCallback(stateCallback)
+                    } catch (e: RuntimeException) {}
+                    unregisterImsCallbacks()
+                }
+            }
+            .catch { e ->
+                Log.w(TAG, "sub=$subId IMS voice flow failed", e)
+                emit(ImsVoiceIcon.NONE)
+            }
+            .distinctUntilChanged()
+    }
+
+    private data class ImsVoiceState(
+        val registered: Boolean = false,
+        val registrationTech: Int = ImsRegistrationImplBase.REGISTRATION_TECH_NONE,
+        val voiceCapable: Boolean = false,
+        val volteSettingEnabled: Boolean = false,
+    ) {
+        fun toIcon(): ImsVoiceIcon =
+            when {
+                !registered || !voiceCapable -> ImsVoiceIcon.NONE
+                registrationTech == ImsRegistrationImplBase.REGISTRATION_TECH_IWLAN ->
+                    ImsVoiceIcon.VOWIFI
+                (registrationTech == ImsRegistrationImplBase.REGISTRATION_TECH_LTE ||
+                    registrationTech == ImsRegistrationImplBase.REGISTRATION_TECH_NR) &&
+                    volteSettingEnabled -> ImsVoiceIcon.HD
+                else -> ImsVoiceIcon.NONE
+            }
+    }
+
+    private companion object {
+        const val TAG = "SoftOSImsVoice"
+    }
+}
